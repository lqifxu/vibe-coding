# DeepSeek（默认）或其它 OpenAI 兼容服务
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
FREE_DAILY_SUMMARIES=10
FREE_DAILY_PARSES=10

# 抖音 AI 总结：云端 OpenAI 兼容 /v1/audio/transcriptions
# 示例（硅基流动 SiliconFlow）：
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# 或 OpenAI：ASR_BASE_URL=https://api.openai.com/v1  ASR_MODEL=whisper-1
# 不要把真实 Key 提交到仓库。
ASR_PROVIDER=api
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
# 可选：
# ASR_TIMEOUT_SEC=120
# ASR_MAX_DURATION_SEC=1200
# 说明：本地 faster-whisper 未启用；勿设置 ASR_PROVIDER=local（会明确报错）。

# B站解析/字幕：云服务器 IP 常被 412 拦截，建议配置 Cookie
# 方式1）整段 Cookie（推荐）：
# BILI_COOKIE=SESSDATA=xxx; bili_jct=xxx; DedeUserID=xxx; buvid3=xxx
# 方式2）只填 SESSDATA：
# SESSDATA=xxx
# 方式3）Netscape cookies.txt 放到 backend/cookies.txt，或：
# YTDLP_COOKIES_FILE=C:/path/to/cookies.txt

# YouTube：国内轻量云访问常超时，可配代理（二选一即可）
# YTDLP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# —— 账号 / 会员 / Stripe ——
DATABASE_PATH=./data/app.db
JWT_SECRET=请换成足够长的随机字符串
# 生产 HTTPS 时设为 true
COOKIE_SECURE=false
PUBLIC_APP_URL=http://127.0.0.1:5173

# Stripe Test mode（Dashboard → Developers → API keys）
STRIPE_SECRET_KEY=sk_test_...
# 本地用 `stripe listen --forward-to http://127.0.0.1:8001/api/billing/webhook` 打印的 whsec_
STRIPE_WEBHOOK_SECRET=whsec_...
# Product catalog 里月度 Price 的 ID
STRIPE_PRICE_ID=price_...
