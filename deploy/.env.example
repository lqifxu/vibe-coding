# 复制为 deploy/.env 后填写（不要提交到 git）

# —— 站点 ——
# 浏览器访问的正式地址（含 https://，无尾斜杠）
PUBLIC_APP_URL=https://example.com
# 构建前端 SEO 用，通常与 PUBLIC_APP_URL 相同
VITE_SITE_URL=https://example.com
# 宿主机映射端口（前面用 Nginx/Caddy 做 HTTPS 时可保持 80）
HTTP_PORT=80

# —— LLM ——
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
FREE_DAILY_SUMMARIES=10
FREE_DAILY_PARSES=10

# —— ASR（抖音无字幕总结；OpenAI 兼容 /audio/transcriptions）——
ASR_PROVIDER=api
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# —— 账号 / Cookie ——
DATABASE_PATH=/app/data/app.db
JWT_SECRET=请换成足够长的随机字符串
COOKIE_SECURE=true

# —— Stripe（上线用 Live；先测可用 Test）——
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# 可选：B 站字幕增强
# BILI_COOKIE=
# SESSDATA=
